{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2022",
      "DOM"
    ],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": false,
    "baseUrl": "..",
    "paths": {
      "@kaleidorg/webrgb": [
        "./index.d.ts"
      ],
      "@kaleidorg/webrgb/mock": [
        "./mock.d.ts"
      ],
      "@kaleidorg/webrgb/conformance": [
        "./conformance.d.ts"
      ]
    },
    "allowJs": true,
    "checkJs": true
  },
  "include": [
    "./consumer.ts",
    "../index.d.ts",
    "../index.js",
    "../mock.d.ts",
    "../mock.js",
    "../conformance.d.ts",
    "../conformance.js"
  ]
}
